  title = {Development and Validation of the Nurturing Parenting Beliefs and Behaviors Scale ({{NPBBS}}): Measuring Parenting in High Andean Peru},
  shorttitle = {Development and Validation of the Nurturing Parenting Beliefs and Behaviors Scale ({{NPBBS}})},
  author = {Hinckley, Kristen and Alvarado, Milagros and McCoy, Dana Charles and Jäggi, Lena and Dormal, Marta and Mäusezahl, Daniel and Hartinger, Stella M. and Castellanos, Andreana and Huaylinos Bustamante, María Luisa and Aguilar, Leonel and Gastiaburú Cabello, María Catalina and Quispe Roncal, Nerita Gabriela and Fink, Günther},
